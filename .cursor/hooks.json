{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-approvals.cmd",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/guard-test-assertions.cmd",
        "matcher": "Write",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/guard-test-assertions.cmd",
        "matcher": "Write",
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/guard-constitution.cmd",
        "matcher": "Write",
        "failClosed": true
      }
    ]
  }
}
