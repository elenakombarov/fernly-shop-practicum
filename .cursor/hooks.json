{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/run-bash.mjs guard-approvals",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/run-bash.mjs guard-test-assertions",
        "matcher": "Write",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/run-bash.mjs guard-test-assertions",
        "matcher": "Write",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/run-bash.mjs guard-constitution",
        "matcher": "Write",
        "failClosed": true
      }
    ]
  }
}
